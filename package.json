{
    "name":  "campusos",
    "version":  "0.1.0",
    "private":  true,
    "license":  "CC-BY-NC-4.0",
    "type":  "module",
    "packageManager":  "npm@11.17.0",
    "engines":  {
                    "node":  "\u003e=22.12.0"
                },
    "scripts":  {
                    "predev":  "node scripts/prepare-map-runtime.mjs",
                    "prebuild":  "node scripts/prepare-map-runtime.mjs \u0026\u0026 node scripts/prepare-route-metadata.mjs --check",
                    "prebuild:worker":  "node scripts/prepare-map-runtime.mjs \u0026\u0026 node scripts/prepare-route-metadata.mjs --check",
                    "map:route-metadata":  "node scripts/prepare-route-metadata.mjs",
                    "dev":  "next dev --hostname 127.0.0.1",
                    "build":  "next build",
                    "start":  "next start --hostname 127.0.0.1",
                    "typecheck":  "next typegen \u0026\u0026 tsc --noEmit",
                    "lint":  "eslint . --max-warnings=0",
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check .",
                    "test":  "vitest run",
                    "build:worker":  "node scripts/build-worker.mjs",
                    "preview:worker":  "opennextjs-cloudflare preview",
                    "db:migrate:local":  "wrangler d1 migrations apply campusos-local --local",
                    "db:verify":  "node scripts/verify-database.mjs",
                    "web:discover-routes":  "node scripts/discover-official-web-routes.mjs",
                    "web:inspect-route-samples":  "node scripts/inspect-official-web-list-samples.mjs",
                    "web:render-route-samples":  "node scripts/render-official-web-route-samples.mjs",
                    "deploy:preview":  "node scripts/deploy.mjs preview",
                    "deploy:production":  "node scripts/deploy.mjs production"
                },
    "dependencies":  {
                         "@base-ui/react":  "1.9.0",
                         "@cloudflare/containers":  "0.3.7",
                         "@cloudflare/playwright":  "1.3.6",
                         "@noble/hashes":  "2.4.0",
                         "gcoord":  "1.0.7",
                         "jose":  "6.2.12",
                         "jpeg-js":  "^0.4.4",
                         "linkedom":  "0.18.13",
                         "lucide-react":  "1.55.0",
                         "maplibre-gl":  "6.14.0",
                         "next":  "16.3.8",
                         "react":  "19.3.0",
                         "react-dom":  "19.3.0",
                         "react-markdown":  "10.1.0",
                         "remark-gfm":  "4.0.1",
                         "three":  "0.186.1",
                         "zod":  "4.6.6"
                     },
    "devDependencies":  {
                            "@amap/amap-jsapi-types":  "0.0.15",
                            "@opennextjs/cloudflare":  "1.20.10",
                            "@playwright/test":  "1.64.0",
                            "@types/node":  "^24.0.0",
                            "@types/pngjs":  "^6.0.5",
                            "@types/react":  "19.3.0",
                            "@types/react-dom":  "^19.0.0",
                            "@types/three":  "0.186.0",
                            "comment-json":  "4.5.1",
                            "eslint":  "9.39.5",
                            "eslint-config-next":  "16.3.8",
                            "jsqr":  "1.4.0",
                            "pngjs":  "^7.0.0",
                            "prettier":  "3.9.10",
                            "typescript":  "5.9.3",
                            "vitest":  "5.0.3",
                            "wrangler":  "4.149.0"
                        },
    "allowScripts":  {
                         "rclone.js@0.6.6":  false,
                         "esbuild@0.28.2":  true,
                         "unrs-resolver@1.12.2":  true,
                         "workerd@1.20261006.1":  true,
                         "esbuild@0.25.4":  true
                     },
    "overrides":  {
                      "@node-minify/core":  {
                                                "glob":  "10.5.0"
                                            },
                      "rclone.js":  {
                                        "adm-zip":  "0.6.1"
                                    }
                  }
}
